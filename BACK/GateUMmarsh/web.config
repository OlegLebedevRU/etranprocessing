<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net"/>
  </configSections>
  <log4net debug="false">
    <appender name="Monitor" type="log4net.Appender.RollingFileAppender">
      <file value="C:\Log\GateUMmarsh.log"/>
      <appendToFile value="true"/>
      <rollingStyle value="Size"/>
      <maxSizeRollBackups value="1"/>
      <maximumFileSize value="10MB"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d - %m%n"/>
      </layout>
    </appender>
    <logger name="Monitor">
      <level value="INFO"/>
      <appender-ref ref="Monitor"/>
    </logger>
  </log4net>
  <appSettings>
    <add key="EtranConfig" value="http://bl.corepay.local/EtranConfig/"/>
    <add key="DBConnName" value="Organizations"/>

    <add key="version" value="1" />
    <add key="agentId" value="0017" />
    <add key="salepointId" value="002" />
    <add key="deviceId" value="B6200008" />
    <add key="regionId" value="62" />


    <!--<add key="version" value="1"/>
    <add key="agentId" value="8"/>
    <add key="salepointId" value="8"/>
    <add key="deviceId" value="B9900008"/>
    <add key="regionId" value="99"/>-->
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5.2" />
      </system.Web>
  -->
  <system.web>
    <!-- 
            Значение параметра compilation debug="true" означает, что в откомпилированную 
            страницу будут вставлены отладочные символы. Так как этот 
            параметр влияет на производительность, следует задавать для него 
            значение True только на этапе разработки.
        -->
    <compilation debug="true" targetFramework="4.5.2"/>
    <!--
            Раздел <authentication> позволяет настроить параметры 
            режима проверки подлинности, используемого ASP.NET для проверки 
            подлинности пользователя, запрашивающего разрешение на доступ. 
        -->
    <authentication mode="Windows"/>
    <!--
            Раздел <customErrors> служит для настройки действий, 
            выполняемых при возникновении необрабатываемой 
            ошибки во время выполнения запроса. В частности, 
            разработчик может задать html-страницы ошибок 
            для отображения вместо трассировки ошибки в стеке.

        <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.htm">
            <error statusCode="403" redirect="NoAccess.htm" />
            <error statusCode="404" redirect="FileNotFound.htm" />
        </customErrors>
        -->
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"/>
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <add value="Service.asmx"/>
      </files>
    </defaultDocument>
  </system.webServer>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="SdpServiceSoap11">
          <security mode="Transport" >
            <transport clientCredentialType="Certificate"></transport>
          </security>
        </binding>
        <binding name="InternalServiceSoap11" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="https://94.79.52.173:6281/SDPServer/SDPendpoints"
  binding="basicHttpBinding" bindingConfiguration="SdpServiceSoap11"
  contract="ServiceReference1.SdpService" name="SdpServiceSoap11">
        <headers>
          <wsse:Security xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">
            <wsse:UsernameToken xmlns:wsu="...">
              <wsse:Username>admin</wsse:Username>
              <wsse:Password Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText">1</wsse:Password>
            </wsse:UsernameToken>
          </wsse:Security>
        </headers>
      </endpoint>

      <!--<endpoint address="http://195.182.143.218:8888/SDPServer/SDPendpoints"
        binding="basicHttpBinding" bindingConfiguration="SdpServiceSoap11"
        contract="ServiceReference1.SdpService" name="SdpServiceSoap11">
        <headers>
          <wsse:Security xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">
            <wsse:UsernameToken xmlns:wsu="...">
              <wsse:Username>admin</wsse:Username>
              <wsse:Password Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordText">1</wsse:Password>
            </wsse:UsernameToken>
          </wsse:Security>
        </headers>
      </endpoint>-->
      <endpoint address="http://195.182.143.218:8888/SDPServer/Internalendpoints"
        binding="basicHttpBinding" bindingConfiguration="InternalServiceSoap11"
        contract="ServiceReference2.InternalService" name="InternalServiceSoap11" />
    </client>
  </system.serviceModel>
</configuration>