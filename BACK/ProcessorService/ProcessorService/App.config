<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" requirePermission="false" />
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <File value="C:\Log\ProcessorService.log" />
      <AppendToFile value="true" />
      <RollingStyle value="Size" />
      <MaxSizeRollBackups value="10" />
      <MaximumFileSize value="50MB" />
      <Layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c [%x] - %m%n" />
      </Layout>
    </appender>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="RollingFileAppender" />
    </root>
  </log4net>
  <appSettings>
    <add key="ServiceName" value="Platerra.ProcessorService" />
    <add key="ServiceDescription" value="Служба платежей." />
    <add key="StartAfter" value="1" />
    <add key="SleepInterval" value="180" />
    <add key="Rek" value="url=http://localhost:9900/cyberplat/Postomat" />
    <add key="Function" value="check" />
    <add key="PaySystem" value="http://localhost:8080/SysCyberPlat/" />
    <add key="SmsService" value="http://localhost:8080/EtranConfig/" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
<connectionStrings><add name="PostomatsEntities" connectionString="metadata=res://*/Data.PostomatModel.csdl|res://*/Data.PostomatModel.ssdl|res://*/Data.PostomatModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=46.38.48.4;initial catalog=Postomats;persist security info=True;user id=phpuser;password=phppwd;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" /></connectionStrings></configuration>