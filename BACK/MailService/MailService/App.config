<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" requirePermission="false"/>
  </configSections>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <File value="MailService.log"/>
      <AppendToFile value="true"/>
      <RollingStyle value="Size"/>
      <MaxSizeRollBackups value="10"/>
      <MaximumFileSize value="50MB"/>
      <Layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c [%x] - %m%n"/>
      </Layout>
    </appender>
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="RollingFileAppender"/>
    </root>
  </log4net>

  <appSettings>

    <!-- интервал проверки новых извещений (минуты) -->
    <add key="MailerCheckListInterval" value="7"/>


    <add key="ServiceName" value="Platerra.MailService"/>
    <add key="ServiceDescription" value="Служба извещений событий процессига Platerra."/>
    
    <add key="EtranConfig" value="http://db.corepay.local/EtranConfig/"/>
    <add key="DBConnName" value="Service"/>


    <add key="DbGetMessages" value="ReportGetForMailExt"/>

    <add key="DbPostResult" value="ReportAttemptResult"/>

    <!--<add key="SMTP_SERVER" value="smtp.yandex.ru"/>
    <add key="MAIL_USER_PLATERRA" value="noreply@platerra.ru"/>
    <add key="MAIL_PASSWD_PLATERRA" value="fds5j8JJe3"/>
    <add key="MAIL_FROM_USER_PLATERRA" value="noreply@platerra.ru"/>-->


    <add key="SmtpAddress" value="smtp.gmail.com"/>
    <add key="MailFrom" value="notify.dvkosov@gmail.com"/>
    <add key="Password" value="notify123"/>
    <add key="MailTo" value="dvkosov@gmail.com"/>
    <add key="Subject" value="Platerra"/>
    <add key="Port" value="587"/>
    <add key="Ssl" value="true"/>
    

    <!--
        <add key="SmtpAddress" value="smtp.yandex.ru"/>
    <add key="MailFrom" value="noreply@platerra.ru"/>
    <add key="Password" value="fds5j8JJe3"/>
    <add key="Port" value="25"/>
    <add key="Ssl" value="false"/>

    -->


  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/></startup>
</configuration>
