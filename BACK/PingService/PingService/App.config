<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" requirePermission="false"/>
  </configSections>
  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <File value="PingService.log"/>
      <AppendToFile value="true"/>
      <RollingStyle value="Size"/>
      <MaxSizeRollBackups value="10"/>
      <MaximumFileSize value="50MB"/>
      <Layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-5p %c [%x] - %m%n"/>
      </Layout>
    </appender>
    <root>
      <level value="DEBUG"/>
      <appender-ref ref="RollingFileAppender"/>
    </root>
  </log4net>

  <appSettings>

    <add key="ServiceName" value="Platerra.PingService" />
    
    <add key="ServiceDescription" value="Служба работоспособности морды." />
    
    <add key="PingResource" value="1https://172.17.100.8/OsmpDispatcher/" />

    <add key="StartAfter" value="300" />

    <add key="SleepInterval" value="180" />

    <add key="MaxAttemptFault" value="3" />

    <add key="Run" value="shutdown" />
    
    <add key="Arguments" value="-r -f -t 5" />
    
  </appSettings>
</configuration>