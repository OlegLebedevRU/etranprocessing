<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net"/>
  </configSections>
  <log4net debug="false">
    <appender name="Monitor" type="log4net.Appender.RollingFileAppender">
      <file value="C:\LOG\PostProcessor.log"/>
      <appendToFile value="true"/>
      <rollingStyle value="Size"/>
      <maxSizeRollBackups value="1"/>
      <maximumFileSize value="10MB"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d - %m%n"/>
      </layout>
    </appender>
    <logger name="Monitor">
      <level value="INFO"/>
      <appender-ref ref="Monitor"/>
    </logger>
  </log4net>
  <appSettings>
    <add key="StartStep" value="5"/>
    <add key="MPThreadLimit" value="50"/>
    <add key="TimeBuffer" value="60000"/>
    <add key="DBConnectionTimeOut" value="600"/>
    <add key="QueueSize" value="255"/>
    <!-- максимальное кол-во задач в очереди на обработку -->
    <add key="ThreadPath" value="\\srv02.corepay.local\pub\PPF\"/>
    <add key="StopTimeOut" value="60"/>
    <!-- тайм аут остановки всех задач-->
    <add key="MessageProcessor" value="http://bl.corepay.local/ProcessingCore/MessageProcessor.asmx"/>
    <add key="SP_NAME" value="PostModule_GetPayments"/>
    <add key="EtranConfig" value="http://buslog/EtranConfig/"/>
    <add key="DBConnName" value="Payments"/>
  </appSettings>
<startup><supportedRuntime version="v2.0.50727"/></startup></configuration>
