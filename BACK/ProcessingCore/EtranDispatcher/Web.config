<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
  </configSections>
  <appSettings>
    <!--
    <add key="MessageProcessor" value="http://localhost:37661/MessageProcessor.asmx"/>
    <add key="MessageProcessor" value="http://bl.corepay.local/ProcessingCore/MessageProcessor.asmx"/>
    <add key="TestMessageProcessor" value="http://bl.corepay.local/mptest/MessageProcessor.asmx"/>
    <add key="SerialNumber" value="2214, 2684"/>
    -->

    <add key="MessageProcessor" value="http://bl.corepay.local/ProcessingCore/MessageProcessor.asmx" />
    <add key="SignKey" value="EtranSignOK" />

    <add key="EtranConfig" value="http://buslog/EtranConfig/" />
    <add key="DBConnNamePayments" value="CorePayments" />
    <add key="TrustedProxyIP" value="176.108.247.249,87.242.100.34" />

    <add key="RetUtf8" value=",0,1,580,4000,4001,4002,500,501,502,3006,3007,3008,3009,3010,3011,3012,3013,3014,3015,857,732,1000301" />

    <add key="AddDefaultParams" value="ТоварУслуга" />
    <add key="InComeEncodingName" value=""/>
    <add key="InUtf8" value=""/>

  </appSettings>
  <log4net debug="false">
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="E:\\Log\\EtranDispatcher.log" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="100MB" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d - %m%n" />
      </layout>
    </appender>
    <root>
      <priority value="INFO" />
      <appender-ref ref="RollingLogFileAppender" />
    </root>
  </log4net>
  <connectionStrings />
  <system.web>
    <!-- 
            Set compilation debug="true" to insert debugging 
            symbols into the compiled page. Because this 
            affects performance, set this value to true only 
            during development.
        -->
    <compilation debug="true">
    </compilation>
    <!--
            The <authentication> section enables configuration 
            of the security authentication mode used by 
            ASP.NET to identify an incoming user. 
        -->
    <authentication mode="Windows" />
    <!--
    <authorization>
         <allow users="devel\payment" />
         <deny      users="*"/>
    </authorization>
    -->
    <!--
            The <customErrors> section enables configuration 
            of what to do if/when an unhandled error occurs 
            during the execution of a request. Specifically, 
            it enables developers to configure html error pages 
            to be displayed in place of a error stack trace.

        <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.htm">
            <error statusCode="403" redirect="NoAccess.htm" />
            <error statusCode="404" redirect="FileNotFound.htm" />
        </customErrors>
        -->
    <globalization requestEncoding="windows-1251" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <add value="etran.ashx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
