          },
          "feedback": {
            "type": "object",
            "properties": {
              "pli": {
                "type": "boolean"
              },
              "fir": {
                "type": "boolean"
              }
            },
            "required": [
              "pli",
              "fir"
            ],
            "additionalProperties": false
          },
          "max_b_frames": {
            "const": 0
          },
          "keyframe_interval_ms": {
            "type": "integer",
            "minimum": 250,
            "maximum": 5000
          },
          "repeat_parameter_sets": {
            "const": true
          },
          "codec": {
            "const": "h265"
          },
          "codec_profile": {
            "const": "main"
          },
          "packetization": {
            "const": "rfc7798"
          },
          "profile_space": {
            "const": 0
          },
          "profile_id": {
            "const": 1
          },
          "tier_flag": {
            "const": 0
          },
          "level_id": {
            "enum": [
              30,
              60,
              63,
              90,
              93,
              120
            ]
          },
          "sprop_max_don_diff": {
            "const": 0
          }
        },
        "required": [
          "track_id",
          "kind",
          "direction",
          "bit_depth",
          "chroma",
          "clock_rate",
          "payload_type",
          "width",
          "height",
          "fps",
          "feedback",
          "max_b_frames",
          "keyframe_interval_ms",
          "repeat_parameter_sets",
          "codec",
          "codec_profile",
          "packetization",
          "profile_space",
          "profile_id",
          "tier_flag",
          "level_id",
          "sprop_max_don_diff"
        ],
        "additionalProperties": false
      },
      "media_capabilities": {
        "type": "object",
        "properties": {
          "contract_version": {
            "const": 2
          },
          "media_contract_versions": {
            "type": "array",
            "items": {
              "enum": [
                1,
                2
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "server_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "dependencies_ready": {
            "type": "boolean"
          },
          "hevc_runtime_verified": {
            "type": "boolean"
          },
          "codecs": {
            "type": "array",
            "items": {
              "enum": [
                "h264",
                "h265"
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "formats": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "codec": {
                      "const": "h264"
                    },
                    "codec_profile": {
                      "const": "baseline"
                    },
                    "packetization": {
                      "const": "rfc6184"
                    },
                    "clock_rate": {
                      "const": 90000
                    }
                  },
                  "required": [
                    "codec",
                    "codec_profile",
                    "packetization",
                    "clock_rate"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "codec": {
                      "const": "h265"
                    },
                    "codec_profile": {
                      "const": "main"
                    },
                    "packetization": {
                      "const": "rfc7798"
                    },
                    "clock_rate": {
                      "const": 90000
                    }
                  },
                  "required": [
                    "codec",
                    "codec_profile",
                    "packetization",
                    "clock_rate"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "max_video_tracks": {
            "const": 1
          },
          "audio_supported": {
            "const": false
          },
          "reverse_rtcp": {
            "type": "boolean"
          }
        },
        "required": [
          "contract_version",
          "media_contract_versions",
          "server_revision",
          "dependencies_ready",
          "hevc_runtime_verified",
          "codecs",
          "formats",
          "max_video_tracks",
          "audio_supported",
          "reverse_rtcp"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "codecs": {
                  "contains": {
                    "const": "h265"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "hevc_runtime_verified": {
                  "const": true
                },
                "dependencies_ready": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "codecs": {
                  "contains": {
                    "const": "h264"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "formats": {
                  "contains": {
                    "properties": {
                      "codec": {
                        "const": "h264"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "formats": {
                  "contains": {
                    "properties": {
                      "codec": {
                        "const": "h264"
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "codecs": {
                  "contains": {
                    "const": "h264"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "codecs": {
                  "contains": {
                    "const": "h265"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "formats": {
                  "contains": {
                    "properties": {
                      "codec": {
                        "const": "h265"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "formats": {
                  "contains": {
                    "properties": {
                      "codec": {
                        "const": "h265"
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "codecs": {
                  "contains": {
                    "const": "h265"
                  }
                }
              }
            }
          }
        ]
      },
      "media_health": {
        "type": "object",
        "properties": {
          "contract_version": {
            "const": 2
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "stream_instance_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "route_generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "state": {
            "enum": [
              "starting",
              "active",
              "stopped",
              "failed"
            ]
          },
          "descriptor": {
            "$ref": "#/components/schemas/descriptor"
          },
          "publisher": {
            "type": "object",
            "properties": {
              "sn": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "stream_instance_id": {
                "type": "string",
                "format": "uuid",
                "minLength": 36,
                "maxLength": 36
              }
            },
            "required": [
              "sn",
              "stream_instance_id"
            ],
            "additionalProperties": false
          },
          "lease_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "mountpoint_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "rtp_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "rtcp_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "janus_ws": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^/"
          },
          "pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "transport": {
            "type": "object",
            "properties": {
              "connected": {
                "type": "boolean"
              },
              "rtp_packets": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "last_rtp_at_ms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5000000000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rtp_fresh": {
                "type": "boolean"
              }
            },
            "required": [
              "connected",
              "rtp_packets",
              "bytes",
              "last_rtp_at_ms",
              "rtp_fresh"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "contract_version",
          "session_id",
          "stream_instance_id",
          "route_generation",
          "state",
          "descriptor",
          "publisher",
          "lease_id",
          "operation_id",
          "mountpoint_id",
          "rtp_port",
          "rtcp_port",
          "janus_ws",
          "transport"
        ],
