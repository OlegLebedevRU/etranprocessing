  "components": {
    "schemas": {
      "descriptor": {
        "type": "object",
        "properties": {
          "descriptor_revision": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36
          },
          "source_type": {
            "enum": [
              "desktop",
              "usb-camera",
              "camera",
              "test"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "geometry_generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "profile_id": {
            "enum": [
              "default",
              "low"
            ]
          },
          "tracks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/track"
            },
            "minItems": 1,
            "maxItems": 1
          }
        },
        "required": [
          "descriptor_revision",
          "source_type",
          "source_id",
          "geometry_generation",
          "profile_id",
          "tracks"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "profile_id": {
                  "const": "low"
                }
              }
            },
            "then": {
              "properties": {
                "tracks": {
                  "items": {
                    "properties": {
                      "fps": {
                        "maximum": 15
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "h264_track": {
        "type": "object",
        "properties": {
          "track_id": {
            "const": "video-main"
          },
          "kind": {
            "const": "video"
          },
          "direction": {
            "const": "producer_to_viewers"
          },
          "bit_depth": {
            "const": 8
          },
          "chroma": {
            "const": "420"
          },
          "clock_rate": {
            "const": 90000
          },
          "payload_type": {
            "type": "integer",
            "minimum": 96,
            "maximum": 127
          },
          "width": {
            "type": "integer",
            "minimum": 2,
            "maximum": 1920,
            "multipleOf": 2
          },
          "height": {
            "type": "integer",
            "minimum": 2,
            "maximum": 1080,
            "multipleOf": 2
          },
          "fps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "feedback": {
            "type": "object",
            "properties": {
              "pli": {
                "type": "boolean"
              },
              "fir": {
                "type": "boolean"
              }
            },
            "required": [
              "pli",
              "fir"
            ],
            "additionalProperties": false
          },
          "max_b_frames": {
            "const": 0
          },
          "keyframe_interval_ms": {
            "type": "integer",
            "minimum": 250,
            "maximum": 5000
          },
          "repeat_parameter_sets": {
            "const": true
          },
          "codec": {
            "const": "h264"
          },
          "codec_profile": {
            "const": "baseline"
          },
          "packetization": {
            "const": "rfc6184"
          },
          "profile_level_id": {
            "type": "string",
            "pattern": "^42[0-9a-f]{4}$"
          },
          "packetization_mode": {
            "const": 1
          }
        },
        "required": [
          "track_id",
          "kind",
          "direction",
          "bit_depth",
          "chroma",
          "clock_rate",
          "payload_type",
          "width",
          "height",
          "fps",
          "feedback",
          "max_b_frames",
          "keyframe_interval_ms",
          "repeat_parameter_sets",
          "codec",
          "codec_profile",
          "packetization",
          "profile_level_id",
          "packetization_mode"
        ],
        "additionalProperties": false
      },
      "h265_track": {
        "type": "object",
        "properties": {
          "track_id": {
            "const": "video-main"
          },
          "kind": {
            "const": "video"
          },
          "direction": {
            "const": "producer_to_viewers"
          },
          "bit_depth": {
            "const": 8
          },
          "chroma": {
            "const": "420"
          },
          "clock_rate": {
            "const": 90000
