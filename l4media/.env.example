# Public IP of the media server
PUBLIC_IP=87.242.100.34

# Inbound mTLS stream port on host
L4MEDIA_PORT=8443

# Host path to client certificate validation CA
CA_CERT_PATH=/home/user1/iot-rpc-rest-app/crt/iot_leo4_ca.crt

# Janus WebRTC Gateway Admin API settings
JANUS_HOST=janus
JANUS_ADMIN_PORT=7088
JANUS_ADMIN_SECRET=janusoverlord

# Service-to-service auth token between MenuBuilder and l4media
L4MEDIA_SERVICE_TOKEN=l4media-service-secret-token

# Set in the private .env file for persistent ingress session ownership.
L4MEDIA_REDIS_URL=

# Technical Details Archive & Retention Worker (L4D-15C-MEDIA)
L4MEDIA_ARCHIVE_WORKER_ENABLED=false
L4MEDIA_ARCHIVE_DRY_RUN=false
L4MEDIA_ARCHIVE_VOLUME_ROOT=/mnt/l4desk-archive
L4MEDIA_HOT_TELEMETRY_DIR=/var/lib/l4media/telemetry
