# Dedicated signer environment; copy outside Git, chmod 0600, fill the secret.
# Use the same INTERNAL secret and issuer context as MenuBuilder backend.
# The external reserve keeps SERVICE_TO_YC_SERVICE_SECRET separately.
JWT_ISSUER_INTERNAL_SECRET=
JWT_ISSUER_CLIENT_ID=menubuilder-backend
JWT_ISSUER_AUD=menubuilder
JWT_ISSUER_ISS=external-jwt-issuer
JWT_ISSUER_KID=menubuilder-rs256-key-1
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
