            "value": "u8"
          },
          {
            "label": "i16 (-32768..32767)",
            "value": "i16"
          },
          {
            "label": "u16 (0..65535)",
            "value": "u16"
          },
          {
            "label": "i32 (-2147483648..2147483647)",
            "value": "i32"
          },
          {
            "label": "u32 (0..4294967295)",
            "value": "u32"
          }
        ]
      },
      {
        "name": "v",
        "label": "Значение (Value)",
        "type": "string",
        "required": true,
        "placeholder": "Значение параметра"
      }
