<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
  </configSections>
  <log4net debug="false">
    <appender name="Monitor" type="log4net.Appender.RollingFileAppender">
      <file value="C:\Log\TechGate.log" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="2" />
      <maximumFileSize value="50MB" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d - %m%n" />
      </layout>
    </appender>
    <logger name="Monitor">
      <level value="INFO" />
      <appender-ref ref="Monitor" />
    </logger>
  </log4net>
  <appSettings>
    <add key="EtranConfig" value="http://buslog/EtranConfig/" />
    <add key="DBConnNameService" value="Service" />
  </appSettings>
  <connectionStrings />
  <system.web>
    <compilation debug="true" targetFramework="4.0" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <add value="etran.ashx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
