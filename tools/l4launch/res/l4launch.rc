#include <windows.h>
#include "../../l4setup/src/version.h"
1 VERSIONINFO
 FILEVERSION L4SETUP_VERSION_MAJOR,L4SETUP_VERSION_MINOR,L4SETUP_VERSION_PATCH,0
 PRODUCTVERSION L4SETUP_VERSION_MAJOR,L4SETUP_VERSION_MINOR,L4SETUP_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Leo4 / Platerra"
   VALUE "FileDescription", "Leo4 stable tools launcher"
   VALUE "InternalName", "l4launch"
   VALUE "OriginalFilename", "l4launch.exe"
   VALUE "ProductName", "Leo4 IoT Platform Tools"
   VALUE "ProductVersion", L4SETUP_VERSION_STRING
   VALUE "FileVersion", L4SETUP_VERSION_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
