          "method_code": 7001,
          "session_id": "sess-exec-9001",
          "command_line": "hostname",
          "shell": "cmd",
          "ttl_sec": 30,
          "topic": "dev/000100773/out"
        }
      },
      "stream_output_chunk": {
        "topic": "dev/000100773/out",
        "payload": {
          "session_id": "sess-exec-9001",
          "seq": 1,
          "data": "TERM-KIOSK-01\r\n",
          "eof": false
        }
      },
      "stream_output_eof": {
        "topic": "dev/000100773/out",
        "payload": {
          "session_id": "sess-exec-9001",
          "seq": 2,
          "data": "",
          "eof": true,
          "exit_code": 0
        }
      },
      "response": {
        "topic": "dev/000100773/res",
        "mqtt_v5_properties": {
          "CorrelationData": "01020304-corr-exec-0001"
