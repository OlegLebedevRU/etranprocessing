        "payload": {
          "id": "task-exec-1001",
          "session_id": "sess-exec-9001",
          "method_code": 7001,
          "status": "completed",
          "exit_code": 0,
          "execution_time_ms": 48
        }
      }
    },
    "exec_powershell_date": {
