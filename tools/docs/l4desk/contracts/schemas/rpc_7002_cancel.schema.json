{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etranprocessing.org/contracts/l4desk/schemas/rpc_7002_cancel.schema.json",
  "title": "RPC7002CancelSchema",
  "description": "JSON Schema defining Method 7002 (Task Cancellation) payloads",
  "definitions": {
    "request": {
      "type": "object",
      "required": ["id", "method_code", "target_task_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "method_code": { "const": 7002 },
        "target_task_id": { "type": "string", "minLength": 1 },
        "target_session_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["id", "method_code", "target_task_id", "status"],
      "properties": {
        "id": { "type": "string" },
        "method_code": { "const": 7002 },
        "target_task_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["cancelled", "not_found", "already_finished"]
        },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
