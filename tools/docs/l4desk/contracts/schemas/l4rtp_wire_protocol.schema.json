{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etranprocessing.org/contracts/l4desk/schemas/l4rtp_wire_protocol.schema.json",
  "title": "L4RTPWireProtocolSchema",
  "description": "JSON Schema defining L4RTP/1 multiplexed streaming protocol frames and preamble",
  "definitions": {
    "preamble": {
      "type": "object",
      "required": ["magic", "version", "reserved", "sn_len", "sn"],
      "properties": {
        "magic": { "const": "L4RT" },
        "version": { "const": 1 },
        "reserved": { "const": 0 },
        "sn_len": { "type": "integer", "minimum": 1, "maximum": 64 },
        "sn": { "type": "string", "pattern": "^[0-9A-Za-z_-]{1,64}$" }
      },
      "additionalProperties": false
    },
    "stream_frame": {
      "type": "object",
      "required": ["channel", "payload_length_bytes", "header_hex"],
      "properties": {
        "channel": { "type": "integer", "enum": [1, 2] },
        "channel_name": { "type": "string", "enum": ["RTP", "RTCP"] },
        "payload_length_bytes": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "header_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{8}$" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
