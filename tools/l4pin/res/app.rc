#include "resource.h"
#include <windows.h>

#define VER_FILEVERSION             1,7,2,0
#define VER_FILEVERSION_STR         "1.7.2.0\0"
#define VER_PRODUCTVERSION          1,7,2,0
#define VER_PRODUCTVERSION_STR       "1.7.2\0"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "l4pin.manifest"

IDI_APP_ICON ICON "icon.ico"

IDD_PIN_GUI DIALOGEX 0, 0, 470, 250
STYLE DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Leo4 Certificate Installer"
FONT 11, "Segoe UI"
BEGIN
    LTEXT "Terminal certificates in LocalMachine\\MY", -1, 14, 10, 440, 17
    LISTBOX IDC_CERT_LIST, 14, 30, 442, 76, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT "One-time PIN", -1, 14, 116, 95, 18
    EDITTEXT IDC_PIN_EDIT, 108, 111, 142, 25, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Refresh", IDC_REFRESH, 366, 111, 90, 25
    CONTROL "Force reissue", IDC_FORCE, "Button", BS_OWNERDRAW | WS_TABSTOP, 14, 145, 250, 34
    LTEXT "Previous terminal certificates are removed after the new key is verified.", -1, 14, 181, 440, 17
    LTEXT "Ready", IDC_STATUS, 14, 202, 440, 18
    DEFPUSHBUTTON "Install certificate", IDC_INSTALL, 253, 224, 125, 20
    PUSHBUTTON "Close", IDCANCEL, 384, 224, 72, 20
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Leo4 / Platerra\0"
            VALUE "FileDescription",  "Leo4 Terminal Certificate Installer (l4pin)\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "l4pin\0"
            VALUE "OriginalFilename", "l4pin.exe\0"
            VALUE "ProductName",      "Leo4 IoT Platform Tools\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
