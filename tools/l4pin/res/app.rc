#include "resource.h"
#include <windows.h>

#define VER_FILEVERSION             1,7,2,0
#define VER_FILEVERSION_STR         "1.7.2.0\0"
#define VER_PRODUCTVERSION          1,7,2,0
#define VER_PRODUCTVERSION_STR       "1.7.2\0"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "l4pin.manifest"

IDI_APP_ICON ICON "icon.ico"

IDD_PIN_GUI DIALOGEX 0, 0, 530, 305
STYLE DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Leo4 Certificate Installer"
FONT 12, "Segoe UI"
BEGIN
    LTEXT "Terminal certificates in LocalMachine\\MY", -1, 16, 14, 500, 18
    LISTBOX IDC_CERT_LIST, 16, 37, 498, 98, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON "Refresh", IDC_REFRESH, 412, 145, 102, 28
    LTEXT "One-time PIN", -1, 16, 149, 110, 22
    EDITTEXT IDC_PIN_EDIT, 128, 145, 155, 29, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Delete old (default)", IDC_DELETE_OLD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 186, 220, 24
    CONTROL "Force reissue", IDC_FORCE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 250, 186, 205, 24
    LTEXT "Matching old certificates are removed only after the new certificate and key are verified.", -1, 16, 215, 498, 22
    LTEXT "Ready", IDC_STATUS, 16, 244, 498, 24
    DEFPUSHBUTTON "Install certificate", IDC_INSTALL, 240, 270, 168, 28
    PUSHBUTTON "Close", IDCANCEL, 416, 270, 98, 28
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Leo4 / Platerra\0"
            VALUE "FileDescription",  "Leo4 Terminal Certificate Installer (l4pin)\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "l4pin\0"
            VALUE "OriginalFilename", "l4pin.exe\0"
            VALUE "ProductName",      "Leo4 IoT Platform Tools\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
