#include "resource.h"
#include <windows.h>

#define VER_FILEVERSION             1,7,4,0
#define VER_FILEVERSION_STR         "1.7.4.0\0"
#define VER_PRODUCTVERSION          1,7,4,0
#define VER_PRODUCTVERSION_STR       "1.7.4\0"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "l4superv.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Leo4 IoT Project\0"
            VALUE "FileDescription",  "Leo4 Services Supervisor, State Orchestrator and Watchdog (l4superv)\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "l4superv\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026\0"
            VALUE "OriginalFilename", "l4superv.exe\0"
            VALUE "ProductName",      "Leo4 Supervisor\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
