#include <windows.h>
#include "resource.h"
#include "../src/version.h"

// Manifest
1 RT_MANIFEST "l4setup.manifest"

// Dialog: PIN prompt
IDD_PIN_DIALOG DIALOGEX 0, 0, 275, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Leo4 Setup - Terminal Activation"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Enter the 6-digit terminal PIN to issue a certificate:", IDC_STATIC_PIN_PROMPT, 15, 15, 245, 16
    EDITTEXT        IDC_PIN_EDIT, 15, 38, 245, 14, ES_AUTOHSCROLL | ES_UPPERCASE | ES_NUMBER
    DEFPUSHBUTTON   "Activate", IDOK, 20, 75, 65, 16
    PUSHBUTTON      "Skip activation", IDC_BTN_SKIP, 95, 75, 90, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 195, 75, 65, 16
END

// Dialog: Main Setup UI
IDD_MAIN_DIALOG DIALOGEX 0, 0, 360, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Leo4 Setup - Installation & Lifecycle"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Leo4 Zero-Touch Setup", IDC_STATIC_HEADER, 15, 10, 330, 14
    LTEXT           "Target Version: 1.7.4 | Operation: Install", IDC_STATIC_VER_INFO, 15, 25, 330, 10
    LTEXT           "Destination: C:\\l4tools", IDC_STATIC_PATH_INFO, 15, 37, 330, 10
    LTEXT           "No automatic reboot or logoff will be performed.", IDC_STATIC_NOTICE, 15, 49, 330, 10

    GROUPBOX        "Services Status", -1, 15, 62, 330, 68
    LTEXT           "Leo4Proxy:  Pending", IDC_SVC_LEO4PROXY, 25, 75, 310, 10
    LTEXT           "mosquitto:  Pending", IDC_SVC_MOSQUITTO, 25, 87, 310, 10
    LTEXT           "L4Con:      Pending", IDC_SVC_L4CON, 25, 99, 310, 10
    LTEXT           "L4Superv:   Pending", IDC_SVC_L4SUPERV, 25, 111, 310, 10

    LTEXT           "Phase: Check (Ready)", IDC_STATIC_PHASE, 15, 134, 330, 10
    LTEXT           "Status: Ready to begin.", IDC_STATIC_STATUS, 15, 146, 330, 10
    LTEXT           "Elapsed: 0s", IDC_STATIC_ELAPSED, 15, 158, 120, 10

    EDITTEXT        IDC_EDIT_DETAILS, 15, 172, 330, 56, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL

    DEFPUSHBUTTON   "Install", IDC_BTN_ACTION, 15, 235, 65, 16
    PUSHBUTTON      "Retry", IDC_BTN_RETRY, 85, 235, 60, 16, WS_DISABLED
    PUSHBUTTON      "View Details", IDC_BTN_DETAILS, 150, 235, 75, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 280, 235, 65, 16
END

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     L4SETUP_VERSION_MAJOR,L4SETUP_VERSION_MINOR,L4SETUP_VERSION_PATCH,L4SETUP_VERSION_BUILD
PRODUCTVERSION  L4SETUP_VERSION_MAJOR,L4SETUP_VERSION_MINOR,L4SETUP_VERSION_PATCH,L4SETUP_VERSION_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Leo4\0"
            VALUE "FileDescription",  "Leo4 Zero-Touch Setup\0"
            VALUE "FileVersion",      L4SETUP_VERSION_STRING "\0"
            VALUE "InternalName",     "l4setup\0"
            VALUE "OriginalFilename", "l4setup.exe\0"
            VALUE "ProductName",      "Leo4 Terminal Tools\0"
            VALUE "ProductVersion",   L4SETUP_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#ifdef EMBED_PAYLOAD_X86
PAYLOAD_X86 RCDATA "payload_x86.bin"
#endif

#ifdef EMBED_PAYLOAD_X64
PAYLOAD_X64 RCDATA "payload_x64.bin"
#endif
