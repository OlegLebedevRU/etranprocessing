#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "../src/version.h"

// Manifest
1 RT_MANIFEST "l4setup.manifest"

// Dialog: PIN prompt
IDD_PIN_DIALOG DIALOGEX 0, 0, 280, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Leo4 Setup - Terminal Activation"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Enter the 6-digit terminal PIN to issue a certificate:", IDC_STATIC_PIN_PROMPT, 15, 15, 250, 16
    EDITTEXT        IDC_PIN_EDIT, 15, 38, 250, 14, ES_AUTOHSCROLL | ES_UPPERCASE | ES_NUMBER
    DEFPUSHBUTTON   "Activate", IDOK, 20, 80, 70, 16
    PUSHBUTTON      "Skip activation", IDC_BTN_SKIP, 95, 80, 95, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 195, 80, 70, 16
END

// Main window: all controls are laid out in DPI-aware client pixels by ui.c.
IDD_MAIN_DIALOG DIALOGEX 0, 0, 700, 460
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
CAPTION "L4 Tools — установка и обновление"
FONT 11, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Установка L4 Tools", IDC_STATIC_HEADER, 15, 10, 350, 32
    LTEXT "Проверка, обновление и запуск компонентов терминала. Автоматической перезагрузки нет.", IDC_STATIC_NOTICE, 15, 45, 660, 28
    LTEXT "Проверяем установленный пакет…", IDC_STATIC_VER_INFO, 15, 80, 220, 48
    LTEXT "Папка установки", IDC_STATIC_PATH_INFO, 15, 132, 220, 32
    LTEXT "Состояние служб", IDC_STATIC_SERVICES_LBL, 15, 168, 220, 22
    LTEXT "Leo4Proxy: ожидание", IDC_SVC_LEO4PROXY, 15, 196, 220, 18
    LTEXT "Mosquitto: ожидание", IDC_SVC_MOSQUITTO, 15, 220, 220, 18
    LTEXT "L4Con: ожидание", IDC_SVC_L4CON, 15, 244, 220, 18
    LTEXT "L4Superv: ожидание", IDC_SVC_L4SUPERV, 15, 268, 220, 18
    LTEXT "Подготовка", IDC_STATIC_PHASE, 15, 304, 165, 20
    RTEXT "0%", IDC_STATIC_PERCENT, 185, 304, 50, 20
    CONTROL "", IDC_PROGRESS_BAR, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_VISIBLE, 15, 328, 220, 12
    LTEXT "Ожидание проверки", IDC_STATIC_STATUS, 15, 348, 220, 40
    LTEXT "Прошло: 0 с", IDC_STATIC_ELAPSED, 15, 401, 220, 20
    LTEXT "Журнал установки", IDC_STATIC_LOG_TITLE, 255, 80, 300, 22
    PUSHBUTTON "Копировать", IDC_BTN_DETAILS, 587, 78, 90, 22
    CONTROL "", IDC_EDIT_DETAILS, "RICHEDIT50W", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP, 255, 110, 422, 286
    LTEXT "Ошибки: 0   Предупреждения: 0", IDC_STATIC_LOG_COUNTS, 255, 410, 205, 22
    DEFPUSHBUTTON "Установить", IDC_BTN_ACTION, 490, 410, 115, 26
    PUSHBUTTON "Отмена", IDCANCEL, 616, 410, 61, 26
END
// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     L4SETUP_VERSION_MAJOR,L4SETUP_VERSION_MINOR,L4SETUP_VERSION_PATCH,L4SETUP_VERSION_BUILD
PRODUCTVERSION  L4SETUP_VERSION_MAJOR,L4SETUP_VERSION_MINOR,L4SETUP_VERSION_PATCH,L4SETUP_VERSION_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Leo4\0"
            VALUE "FileDescription",  "Leo4 Zero-Touch Setup\0"
            VALUE "FileVersion",      L4SETUP_VERSION_STRING "\0"
            VALUE "InternalName",     "l4setup\0"
            VALUE "OriginalFilename", "l4setup.exe\0"
            VALUE "ProductName",      "Leo4 Terminal Tools\0"
            VALUE "ProductVersion",   L4SETUP_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#ifdef EMBED_PAYLOAD_X86
PAYLOAD_X86 RCDATA "payload_x86.bin"
#endif

#ifdef EMBED_PAYLOAD_X64
PAYLOAD_X64 RCDATA "payload_x64.bin"
#endif
