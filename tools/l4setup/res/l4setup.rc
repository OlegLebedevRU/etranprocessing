#include <windows.h>
#include "resource.h"
#include "../src/version.h"

// Manifest
1 RT_MANIFEST "l4setup.manifest"

// Dialog: PIN prompt
IDD_PIN_DIALOG DIALOGEX 0, 0, 280, 115
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Leo4 Setup - Terminal Activation"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Enter the 6-digit terminal PIN to issue a certificate:", IDC_STATIC_PIN_PROMPT, 15, 15, 250, 16
    EDITTEXT        IDC_PIN_EDIT, 15, 38, 250, 14, ES_AUTOHSCROLL | ES_UPPERCASE | ES_NUMBER
    DEFPUSHBUTTON   "Activate", IDOK, 20, 80, 70, 16
    PUSHBUTTON      "Skip activation", IDC_BTN_SKIP, 95, 80, 95, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 195, 80, 70, 16
END

// Dialog: Main Setup UI
IDD_MAIN_DIALOG DIALOGEX 0, 0, 400, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Leo4 Setup - Installation & Lifecycle"
FONT 10, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Leo4 Zero-Touch Setup", IDC_STATIC_HEADER, 15, 10, 370, 19
    LTEXT           "Target Version: 1.8.1-beta-1 | Operation: Install", IDC_STATIC_VER_INFO, 15, 32, 370, 14
    LTEXT           "Destination: C:\\l4tools", IDC_STATIC_PATH_INFO, 15, 48, 370, 14
    LTEXT           "Safe lifecycle (no automatic reboot).", IDC_STATIC_NOTICE, 15, 64, 370, 14

    GROUPBOX        "Background Services", IDC_STATIC_SERVICES_LBL, 15, 83, 370, 69
    LTEXT           "Leo4Proxy:  Pending", IDC_SVC_LEO4PROXY, 25, 97, 350, 13
    LTEXT           "mosquitto:  Pending", IDC_SVC_MOSQUITTO, 25, 110, 350, 13
    LTEXT           "L4Con:      Pending", IDC_SVC_L4CON, 25, 123, 350, 13
    LTEXT           "L4Superv:   Pending", IDC_SVC_L4SUPERV, 25, 136, 350, 13

    LTEXT           "Phase: Inspect", IDC_STATIC_PHASE, 15, 158, 275, 15
    RTEXT           "0%", IDC_STATIC_PERCENT, 305, 158, 80, 15
    CONTROL         "", IDC_PROGRESS_BAR, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_VISIBLE, 15, 175, 370, 16
    LTEXT           "Checking system...", IDC_STATIC_STATUS, 15, 196, 290, 22
    RTEXT           "Elapsed: 0s", IDC_STATIC_ELAPSED, 305, 196, 80, 22

    EDITTEXT        IDC_EDIT_DETAILS, 15, 222, 370, 67, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER

    DEFPUSHBUTTON   "Install", IDC_BTN_ACTION, 15, 298, 90, 24
    PUSHBUTTON      "Retry", IDC_BTN_RETRY, 110, 298, 75, 24, WS_DISABLED
    PUSHBUTTON      "Hide Details", IDC_BTN_DETAILS, 190, 298, 95, 24
    PUSHBUTTON      "Cancel", IDCANCEL, 310, 298, 75, 24
END

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     L4SETUP_VERSION_MAJOR,L4SETUP_VERSION_MINOR,L4SETUP_VERSION_PATCH,L4SETUP_VERSION_BUILD
PRODUCTVERSION  L4SETUP_VERSION_MAJOR,L4SETUP_VERSION_MINOR,L4SETUP_VERSION_PATCH,L4SETUP_VERSION_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Leo4\0"
            VALUE "FileDescription",  "Leo4 Zero-Touch Setup\0"
            VALUE "FileVersion",      L4SETUP_VERSION_STRING "\0"
            VALUE "InternalName",     "l4setup\0"
            VALUE "OriginalFilename", "l4setup.exe\0"
            VALUE "ProductName",      "Leo4 Terminal Tools\0"
            VALUE "ProductVersion",   L4SETUP_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#ifdef EMBED_PAYLOAD_X86
PAYLOAD_X86 RCDATA "payload_x86.bin"
#endif

#ifdef EMBED_PAYLOAD_X64
PAYLOAD_X64 RCDATA "payload_x64.bin"
#endif
