# Database
DATABASE_URL=

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:8080","https://example.com"]

# External CA
CA_URL=
CA_TIMEOUT=30
CERT_VALIDITY_DAYS=365

# Certificates
CERT_PROVIDER=Microsoft Software Key Storage Provider
SIGN_KEY=

# Explicit cutover; external remains the compatibility default until consumers are verified.
CA_SIGNER_BACKEND=external
CA_ISSUING_KEY_PATH=
# Empty certificate path uses the pinned public Issuing CA packaged with the application.
CA_ISSUING_CERT_PATH=
CA_ISSUING_KEY_PASSWORD_FILE=
CA_ISSUING_KEY_PASSWORD=

# Required for production service PIN API; provision privately and share only with its service client.
SERVICE_AUTH_TOKEN=
