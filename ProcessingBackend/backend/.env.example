# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:8080","https://example.com"]

# External CA
CA_URL=https://ca.internal/sign-csr
CA_TIMEOUT=30
CERT_VALIDITY_DAYS=365

# Certificates
CERT_PROVIDER=Microsoft Software Key Storage Provider
SIGN_KEY=EtranSignOK
